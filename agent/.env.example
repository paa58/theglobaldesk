# Cookies da sua sessão no X (veja README.md - passo 3)
TWITTER_AUTH_TOKEN=
TWITTER_CT0=

# Bot do Telegram (veja README.md - passo 4)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Chave da API da Anthropic, para redigir as matérias (console.anthropic.com)
ANTHROPIC_API_KEY=

# GitHub, para publicar os posts aprovados no blog (veja README.md - passo 6)
GITHUB_TOKEN=
GITHUB_OWNER=seu-usuario-github
GITHUB_REPO=nome-do-repositorio
GITHUB_BRANCH=main

# A cada quantos minutos o agente verifica novos posts
POLL_INTERVAL_MINUTES=30
