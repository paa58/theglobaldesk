---
import { COUNTRIES } from '../countries.js';
const { title } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width" />
  <title>{title} | The Global Desk</title>
  <style>
    body { font-family: -apple-system, Georgia, serif; max-width: 760px; margin: 0 auto; padding: 2rem 1rem; color: #1a1a1a; line-height: 1.6; }
    a { color: #0a5cb8; }
    header { border-bottom: 2px solid #111; margin-bottom: 1rem; padding-bottom: 1rem; }
    header h1 { font-size: 1.9rem; margin: 0 0 0.8rem; letter-spacing: -0.5px; }
    nav { display: flex; flex-wrap: wrap; gap: 0.4rem 0; }
    nav a {
      text-decoration: none; color: #333; font-size: 0.85rem; font-weight: 600;
      text-transform: uppercase; letter-spacing: 0.3px;
      padding: 0.3rem 0.7rem; border: 1px solid #ddd; border-radius: 999px;
      margin-right: 0.4rem;
    }
    nav a:hover { background: #111; color: #fff; border-color: #111; }
    .post-list { list-style: none; padding: 0; }
    .post-list li { margin-bottom: 1.5rem; padding-bottom: 1.5rem; border-bottom: 1px solid #eee; }
    .post-list h2 { margin: 0 0 0.3rem; font-size: 1.3rem; }
    .meta { color: #666; font-size: 0.85rem; }
    .tag { display: inline-block; background: #f1f1f1; border-radius: 4px; padding: 0.1rem 0.5rem; font-size: 0.75rem; text-transform: uppercase; margin-bottom: 0.4rem; }
  </style>
</head>
<body>
  <header>
    <h1><a href={base} style="text-decoration:none; color:inherit;">🌐 The Global Desk</a></h1>
    <nav>
      <a href={base}>Home</a>
      {COUNTRIES.map(c => (
        <a href={`${base}paises/${c.slug}/`}>{c.label}</a>
      ))}
    </nav>
  </header>
  <slot />
</body>
</html>
