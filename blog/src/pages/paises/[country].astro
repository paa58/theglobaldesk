---
import Layout from '../../layouts/Layout.astro';
import { COUNTRIES } from '../../countries.js';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  return COUNTRIES.map(c => ({ params: { country: c.slug } }));
}

const base = import.meta.env.BASE_URL;
const { country } = Astro.params;
const label = COUNTRIES.find(c => c.slug === country)?.label || country;
const posts = (await getCollection('posts', p => p.data.country === country))
  .sort((a,b) => b.data.pubDate - a.data.pubDate);
---
<Layout title={label}>
  <h2 style="margin-top:0;">{label}</h2>
  {posts.length === 0 && <p>Ainda não há matérias publicadas nesta seção.</p>}
  <ul class="post-list">
    {posts.map(post => (
      <li>
        <h2><a href={`${base}posts/${post.slug}/`}>{post.data.title}</a></h2>
        <p class="meta">{post.data.pubDate.toLocaleDateString('pt-BR')} {post.data.sourceAuthor && `· via @${post.data.sourceAuthor}`}</p>
        <p>{post.data.description}</p>
      </li>
    ))}
  </ul>
</Layout>
